cc = clang
cflags = -Os -fno-asynchronous-unwind-tables -ffunction-sections -fdata-sections -Wall -Wextra -pedantic -Werror -std=c99 -Isrc/common
ldflags = -Wl,--gc-sections

rule cc
  command = $cc $cflags -c $in -o $out
  description = CC $out

rule link_drop
  command = $cc $ldflags $in -lz -o $out && strip -s $out
  description = LINK_DROP $out

rule link_sink
  command = $cc $ldflags $in -lgit2 -lcurl -lz -o $out && strip -s $out
  description = LINK_SINK $out

# Common objects
build src/common/port.o: cc src/common/port.c
build src/common/sha256.o: cc src/common/sha256.c
build src/common/spawn_util.o: cc src/common/spawn_util.c
build src/common/tar.o: cc src/common/tar.c

# drop objects
build src/drop/main.o: cc src/drop/main.c
build src/drop/index.o: cc src/drop/index.c
build src/drop/db.o: cc src/drop/db.c
build src/drop/extractor.o: cc src/drop/extractor.c

# sink objects
build src/sink/main.o: cc src/sink/main.c
build src/sink/deps.o: cc src/sink/deps.c
build src/sink/git_util.o: cc src/sink/git_util.c
build src/sink/elf_strip.o: cc src/sink/elf_strip.c
build src/sink/builder.o: cc src/sink/builder.c

# Executables
build src/drop/drop: link_drop src/drop/main.o src/drop/index.o src/drop/db.o src/drop/extractor.o src/common/port.o src/common/sha256.o src/common/spawn_util.o src/common/tar.o
build src/sink/sink: link_sink src/sink/main.o src/sink/deps.o src/sink/git_util.o src/sink/elf_strip.o src/sink/builder.o src/common/port.o src/common/sha256.o src/common/spawn_util.o src/common/tar.o

build all: phony src/drop/drop src/sink/sink
default all
