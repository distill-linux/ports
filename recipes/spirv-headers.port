PORT_NAME="spirv-headers"
PORT_VERSION="1.4.350.1"
PORT_RELEASE="1"
PORT_DESC="Machine-readable files for the SPIR-V Registry"
PORT_URL="https://github.com/KhronosGroup/SPIRV-Headers"
PORT_COMMIT="1.4.350.1"
BUILD_SYSTEM="cmake"
BUILD_DEPS=""
RUN_DEPS=""

BUILD:
cmake -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release
samu -C build
DESTDIR="$PKG_FAKEROOT" samu -C build install
