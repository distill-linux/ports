PORT_NAME="xfsprogs"
PORT_VERSION="6.19.0"
PORT_RELEASE="1"
PORT_DESC="Utilities for managing the XFS filesystem"
PORT_URL="http://xfs.org/index.php/Main_Page"
PORT_COMMIT="6.19.0"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="gettext pkg-config"
RUN_DEPS="libblkid-devel libedit-devel inih-devel liburcu-devel
 libuuid-devel"

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
