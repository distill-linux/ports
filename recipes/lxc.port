PORT_NAME="lxc"
PORT_VERSION="6.0.3"
PORT_RELEASE="1"
PORT_DESC="Linux Containers userspace tools and runtime library"
PORT_URL="https://github.com/lxc/lxc.git"
PORT_ARCH="x86_64"
RUN_DEPS="libcap libseccomp gnutls"

BUILD:
meson setup build --prefix=/usr --buildtype=release
samu -C build
DESTDIR="$PKG_FAKEROOT" samu -C build install
