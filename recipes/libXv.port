PORT_NAME="libXv"
PORT_VERSION="1.0.13"
PORT_RELEASE="1"
PORT_DESC="Xv Extension library"
PORT_URL="${XORG_SITE}"
PORT_COMMIT="1.0.13"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="pkg-config"
RUN_DEPS="xorgproto libX11-devel libXext-devel"

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
