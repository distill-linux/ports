PORT_NAME="xcb-util-cursor"
PORT_VERSION="0.1.4"
PORT_RELEASE="1"
PORT_DESC="XCB cursor library (libxcursor port)"
PORT_URL="https://xcb.freedesktop.org"
PORT_COMMIT="0.1.4"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="pkg-config gperf m4"
RUN_DEPS="xcb-util-renderutil-devel xcb-util-image-devel"

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
