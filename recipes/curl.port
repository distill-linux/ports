PORT_NAME="curl"
PORT_VERSION="8.21.0"
PORT_RELEASE="1"
PORT_DESC="Client that groks URLs"
PORT_URL="https://curl.se"
PORT_COMMIT="8.21.0"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="perl pkg-config mdocml"
RUN_DEPS="zlib"

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
