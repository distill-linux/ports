PORT_NAME="mesa"
PORT_VERSION="26.1.8"
PORT_RELEASE="1"
PORT_DESC="Open source implementation of OpenGL and Vulkan"
PORT_URL="https://www.mesa3d.org/"
PORT_COMMIT="26.1.8"
BUILD_SYSTEM="meson"
BUILD_DEPS="gettext flex pkg-config python3-Mako glslang llvm${_llvmver}
 $(vopt_if wayland 'wayland-protocols wayland-devel') python3-pycparser python3-yaml"
RUN_DEPS="elfutils libXdamage libdrm libva libxshmfence zlib libXrandr libglvnd libarchive libXext libpng"

BUILD:
meson setup build --prefix=/usr --buildtype=release
samu -C build
DESTDIR="$PKG_FAKEROOT" samu -C build install
