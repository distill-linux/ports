PORT_NAME="xkill"
PORT_VERSION="1.0.7"
PORT_RELEASE="1"
PORT_DESC="Kill a client by its X resource"
PORT_URL="http://xorg.freedesktop.org"
PORT_COMMIT="1.0.7"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="pkg-config"
RUN_DEPS="libX11 libXmu"

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
