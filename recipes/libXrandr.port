PORT_NAME="libXrandr"
PORT_VERSION="1.5.5"
PORT_RELEASE="1"
PORT_DESC="X RandR Library from X.org"
PORT_URL="https://www.x.org/"
PORT_COMMIT="1.5.5"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="pkg-config"
RUN_DEPS="libXext libXrender libX11"

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
