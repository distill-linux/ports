PORT_NAME="libtool"
PORT_VERSION="2.4.7"
PORT_RELEASE="1"
PORT_DESC="Generic library support script"
PORT_URL="http://www.gnu.org/software/libtool"
PORT_COMMIT="2.4.7"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="texinfo perl automake help2man xz gnulib tar"
RUN_DEPS=""

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
