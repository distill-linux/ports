PORT_NAME="xkeyboard-config"
PORT_VERSION="2.48"
PORT_RELEASE="1"
PORT_DESC="X Keyboard Configuration Database"
PORT_URL="https://gitlab.freedesktop.org/xkeyboard-config/xkeyboard-config"
PORT_ARCH="x86_64"
BUILD_SYSTEM="meson"
BUILD_DEPS="xkbcomp"
RUN_DEPS="xkbcomp"

BUILD:
meson setup build --prefix=/usr
samu -C build
DESTDIR="$PKG_FAKEROOT" samu -C build install
