PORT_NAME="containerd"
PORT_VERSION="2.3.2"
PORT_RELEASE="1"
PORT_DESC="Open and reliable container runtime daemon"
PORT_URL="https://github.com/containerd/containerd.git"
PORT_ARCH="x86_64"
RUN_DEPS="runc libseccomp btrfs-progs"

BUILD:
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install PREFIX=/usr
