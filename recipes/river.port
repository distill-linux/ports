PORT_NAME="river"
PORT_VERSION="0.3.7"
PORT_RELEASE="1"
PORT_DESC="Dynamic tiling Wayland compositor"
PORT_URL="https://codeberg.org/river/river"
PORT_COMMIT="0.3.7"
BUILD_SYSTEM="zig-build"
BUILD_DEPS="pkg-config wayland-devel scdoc"
RUN_DEPS="wlroots0.18-devel libevdev-devel pixman-devel
 wayland-protocols libxkbcommon-devel wayland-devel"

BUILD:
make CC=clang PREFIX=/usr
make DESTDIR="$PKG_FAKEROOT" PREFIX=/usr install
