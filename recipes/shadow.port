PORT_NAME="shadow"
PORT_VERSION="4.8.1"
PORT_RELEASE="1"
PORT_DESC="Shadow password file utilities"
PORT_URL="https://github.com/shadow-maint/shadow"
PORT_COMMIT="4.8.1"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="libtool"
RUN_DEPS=""

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
