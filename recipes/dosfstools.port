PORT_NAME="dosfstools"
PORT_VERSION="4.2"
PORT_RELEASE="1"
PORT_DESC="DOS filesystem tools"
PORT_URL="https://github.com/dosfstools/dosfstools"
PORT_COMMIT="4.2"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="pkg-config"
RUN_DEPS=""

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
