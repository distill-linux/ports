PORT_NAME="libXext"
PORT_VERSION="1.3.7"
PORT_RELEASE="1"
PORT_DESC="X Extension library"
PORT_URL="https://gitlab.freedesktop.org/xorg/lib/libxext"
PORT_COMMIT="1.3.7"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="pkg-config"
RUN_DEPS="xorgproto libX11-devel"

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
