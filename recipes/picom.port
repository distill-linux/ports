PORT_NAME="picom"
PORT_VERSION="13"
PORT_RELEASE="1"
PORT_DESC="Lightweight compositor for X11 (previously a compton fork)"
PORT_URL="https://github.com/yshui/picom/"
PORT_COMMIT="13"
BUILD_SYSTEM="meson"
BUILD_DEPS="pkg-config ruby-asciidoctor"
RUN_DEPS="dbus libepoxy pcre2 pixman xcb-util-image xcb-util-renderutil"

BUILD:
meson setup build --prefix=/usr --buildtype=release
samu -C build
DESTDIR="$PKG_FAKEROOT" samu -C build install
