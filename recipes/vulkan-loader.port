PORT_NAME="vulkan-loader"
PORT_VERSION="1.4.350.1"
PORT_RELEASE="1"
PORT_DESC="Vulkan Installable Client Driver (ICD) loader"
PORT_URL="https://www.khronos.org/vulkan/"
PORT_COMMIT="1.4.350.1"
BUILD_SYSTEM="cmake"
BUILD_DEPS="python3 pkg-config"
RUN_DEPS="Vulkan-Headers libxcb-devel libXrandr-devel wayland-devel"

BUILD:
cmake -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release
samu -C build
DESTDIR="$PKG_FAKEROOT" samu -C build install
