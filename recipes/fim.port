PORT_NAME="fim"
PORT_VERSION="0.7.1"
PORT_RELEASE="1"
PORT_DESC="Fbi IMproved - image viewer"
PORT_URL="https://www.nongnu.org/fbi-improved/"
PORT_COMMIT="0.7.1"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="flex autoconf pkg-config"
RUN_DEPS="giflib libjpeg-turbo libpng libwebp"

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
