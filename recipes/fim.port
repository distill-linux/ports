PORT_NAME="fim"
PORT_VERSION="0.7.1"
PORT_RELEASE="1"
PORT_DESC="Fbi IMproved - image viewer"
PORT_URL="https://www.nongnu.org/fbi-improved/"
PORT_COMMIT="0.7.1"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="flex autoconf pkg-config"
RUN_DEPS="SDL2-devel djvulibre-devel giflib-devel gtk+3-devel jasper-devel
 libjpeg-turbo-devel libavif-devel libcaca-devel libexif-devel libpng-devel
 libspectre-devel libwebp-devel poppler-cpp-devel poppler-glib-devel
 readline-devel tiff-devel"

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
