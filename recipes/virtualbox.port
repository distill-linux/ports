PORT_NAME="virtualbox"
PORT_VERSION="7.1.6"
PORT_RELEASE="1"
PORT_DESC="Powerful x86 and AMD64/Intel64 virtualization software"
PORT_URL="https://www.virtualbox.org/"
PORT_ARCH="x86_64"
RUN_DEPS="libxml2 libpng openssl libvpx libX11 libXt"

BUILD:
./configure --disable-kmods --disable-docs --prefix=/usr
kmk
kmk install DESTDIR="$PKG_FAKEROOT" 
