PORT_NAME="gmp"
PORT_VERSION="6.3.0"
PORT_RELEASE="1"
PORT_DESC="Library for arbitrary precision arithmetic"
PORT_URL="https://gmplib.org/"
PORT_ARCH="x86_64"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS=""
RUN_DEPS=""

BUILD:
./configure --prefix=/usr --enable-cxx
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
