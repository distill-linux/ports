PORT_NAME="libXrender"
PORT_VERSION="0.9.12"
PORT_RELEASE="1"
PORT_DESC="X Render Library"
PORT_URL="${XORG_SITE}"
PORT_COMMIT="0.9.12"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="pkg-config"
RUN_DEPS="xorgproto libXext-devel"

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
