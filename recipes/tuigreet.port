PORT_NAME="tuigreet"
PORT_VERSION="0.11.1"
PORT_RELEASE="1"
PORT_DESC="Graphical console greeter for greetd"
PORT_URL="https://github.com/apognu/tuigreet"
PORT_ARCH="x86_64"
BUILD_SYSTEM="cargo"
BUILD_DEPS="cargo"
RUN_DEPS="greetd libgcc"

BUILD:
cargo build --release
install -Dm755 target/release/tuigreet "$PKG_FAKEROOT/usr/bin/tuigreet"
