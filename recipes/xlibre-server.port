PORT_NAME="xlibre-server"
PORT_VERSION="main"
PORT_RELEASE="1"
PORT_DESC="X11Libre modern standalone X server without legacy cruft or systemd"
PORT_URL="https://github.com/X11Libre/xserver.git"
PORT_COMMIT="main"
BUILD_SYSTEM="meson"
BUILD_DEPS=""
RUN_DEPS="xorg-server-common libpciaccess nettle gmp libXfont2 libfontenc freetype libtirpc mit-krb5-libs libxcvt xkbcomp libxkbfile xkeyboard-config pixman libdrm libXau libXdmcp libxshmfence eudev brotli libpng bzip2 zlib"

BUILD:
meson setup build --prefix=/usr -Dxorg=true -Dxephyr=true -Dseatd=true -Dsystemd_logind=false
samu -C build
DESTDIR="$PKG_FAKEROOT" samu -C build install
