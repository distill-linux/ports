PORT_NAME="xlogo"
PORT_VERSION="1.0.7"
PORT_RELEASE="1"
PORT_DESC="X Window System logo"
PORT_URL="http://www.x.org/archive/X11R6.8.1/doc/xlogo.1.html"
PORT_COMMIT="1.0.7"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="pkg-config"
RUN_DEPS="libXaw-devel"

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
