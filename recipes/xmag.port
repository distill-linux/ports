PORT_NAME="xmag"
PORT_VERSION="1.0.8"
PORT_RELEASE="1"
PORT_DESC="X utility to Magnify parts of the screen"
PORT_URL="https://gitlab.freedesktop.org/xorg/app/xmag"
PORT_COMMIT="1.0.8"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="pkg-config"
RUN_DEPS="libXau libXext libXmu libXaw"

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
