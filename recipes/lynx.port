PORT_NAME="lynx"
PORT_VERSION="2.9.3"
PORT_RELEASE="1"
PORT_DESC="Text browser for the World Wide Web"
PORT_URL="http://lynx.invisible-island.net/"
PORT_COMMIT="2.9.3"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS=""
RUN_DEPS="zlib-devel bzip2-devel ncurses-devel openssl-devel"

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
