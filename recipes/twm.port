PORT_NAME="twm"
PORT_VERSION="1.0.13.1"
PORT_RELEASE="1"
PORT_DESC="Tab Window Manager for the X Window System"
PORT_URL="http://www.x.org/archive/X11R6.8.1/doc/twm.1.html"
PORT_COMMIT="1.0.13.1"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="pkg-config xorg-util-macros bison"
RUN_DEPS="libXmu-devel"

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
