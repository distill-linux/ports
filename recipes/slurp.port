PORT_NAME="slurp"
PORT_VERSION="1.5.0"
PORT_RELEASE="1"
PORT_DESC="Select a region in a Wayland compositor"
PORT_URL="https://wayland.emersion.fr/slurp/"
PORT_COMMIT="1.5.0"
BUILD_SYSTEM="meson"
BUILD_DEPS="pkg-config wayland-devel scdoc"
RUN_DEPS="wayland-devel wayland-protocols cairo-devel libxkbcommon-devel"

BUILD:
meson setup build --prefix=/usr --buildtype=release
samu -C build
DESTDIR="$PKG_FAKEROOT" samu -C build install
