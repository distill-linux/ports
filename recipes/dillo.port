PORT_NAME="dillo"
PORT_VERSION="3.3.0"
PORT_RELEASE="1"
PORT_DESC="Small and light graphical web browser"
PORT_URL="https://dillo-browser.github.io/"
PORT_COMMIT="3.3.0"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="which automake"
RUN_DEPS="brotli-devel fltk-devel libwebp-devel openssl-devel"

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
