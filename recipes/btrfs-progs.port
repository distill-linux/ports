PORT_NAME="btrfs-progs"
PORT_VERSION="6.11"
PORT_RELEASE="1"
PORT_DESC="Btrfs filesystem utilities"
PORT_URL="https://btrfs.wiki.kernel.org/index.php/Main_Page"
PORT_COMMIT="6.11"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="pkgconf python3-Sphinx python3-sphinx_rtd_theme"
RUN_DEPS="zlib"

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
