PORT_NAME="hsetroot"
PORT_VERSION="1.0.5"
PORT_RELEASE="1"
PORT_DESC="Tool which changes X server wallpapers"
PORT_URL="https://github.com/himdel/hsetroot"
PORT_COMMIT="1.0.5"
BUILD_SYSTEM="gnu-makefile"
BUILD_DEPS="automake libtool pkg-config"
RUN_DEPS="libX11 libXinerama"

BUILD:
make CC=clang PREFIX=/usr
make DESTDIR="$PKG_FAKEROOT" PREFIX=/usr install
