PORT_NAME="musl-fts"
PORT_VERSION="1.2.7"
PORT_RELEASE="1"
PORT_DESC="Implementation of fts(3) for musl libc"
PORT_URL="https://github.com/void-linux/musl-fts"
PORT_COMMIT="1.2.7"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="automake libtool"
RUN_DEPS=""

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
