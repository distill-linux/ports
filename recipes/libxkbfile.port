PORT_NAME="libxkbfile"
PORT_VERSION="1.1.3"
PORT_RELEASE="1"
PORT_DESC="Xkbfile Library from X.org"
PORT_URL="https://xorg.freedesktop.org"
PORT_ARCH="x86_64"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="libX11"
RUN_DEPS="libX11"

BUILD:
./configure --prefix=/usr
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
