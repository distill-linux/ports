PORT_NAME="libfontenc"
PORT_VERSION="1.1.9"
PORT_RELEASE="1"
PORT_DESC="Fontenc Library from X.org"
PORT_URL="https://xorg.freedesktop.org/"
PORT_COMMIT="1.1.9"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="pkg-config"
RUN_DEPS="xorgproto zlib-devel"

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
