PORT_NAME="pipewire"
PORT_VERSION="1.6.7"
PORT_RELEASE="1"
PORT_DESC="Server and user space API to deal with multimedia pipelines"
PORT_URL="https://pipewire.org/"
PORT_COMMIT="1.6.7"
BUILD_SYSTEM="meson"
BUILD_DEPS="doxygen pkg-config python3-docutils gettext glib-devel"
RUN_DEPS="libva vulkan-loader openssl dbus"

BUILD:
meson setup build --prefix=/usr --buildtype=release
samu -C build
DESTDIR="$PKG_FAKEROOT" samu -C build install
