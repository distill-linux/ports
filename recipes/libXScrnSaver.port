PORT_NAME="libXScrnSaver"
PORT_VERSION="1.2.5"
PORT_RELEASE="1"
PORT_DESC="X11 Screen Saver Library"
PORT_URL="https://cgit.freedesktop.org/xorg/lib/libXScrnSaver/"
PORT_COMMIT="1.2.5"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="pkg-config"
RUN_DEPS="xorgproto libX11-devel libXext-devel"

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
