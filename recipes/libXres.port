PORT_NAME="libXres"
PORT_VERSION="1.2.3"
PORT_RELEASE="1"
PORT_DESC="X Resource Information Extension Library"
PORT_URL="https://gitlab.freedesktop.org/xorg/lib/libxres"
PORT_COMMIT="1.2.3"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="pkg-config"
RUN_DEPS="libXext"

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
