PORT_NAME="w3m"
PORT_VERSION="0.5.6"
PORT_RELEASE="1"
PORT_DESC="Text-based Web browser and pager (with Debian patches)"
PORT_URL="https://sr.ht/~rkta/w3m/"
PORT_COMMIT="0.5.6"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="pkg-config gc-devel perl gettext nkf"
RUN_DEPS="zlib openssl libX11"

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
