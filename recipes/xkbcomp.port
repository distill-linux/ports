PORT_NAME="xkbcomp"
PORT_VERSION="1.5.0"
PORT_RELEASE="1"
PORT_DESC="XKB keymap compiler"
PORT_URL="https://xorg.freedesktop.org"
PORT_ARCH="x86_64"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="libX11 libxkbfile"
RUN_DEPS="libX11 libxkbfile"

BUILD:
./configure --prefix=/usr
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
