PORT_NAME="xhost"
PORT_VERSION="1.0.10"
PORT_RELEASE="1"
PORT_DESC="Server access control program for X"
PORT_URL="http://xorg.freedesktop.org"
PORT_COMMIT="1.0.10"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="pkg-config gettext"
RUN_DEPS="libX11-devel libXmu-devel"

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
