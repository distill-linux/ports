PORT_NAME="libXt"
PORT_VERSION="1.3.1"
PORT_RELEASE="1"
PORT_DESC="X Toolkit Intrinsics library"
PORT_URL="http://xorg.freedesktop.org"
PORT_COMMIT="1.3.1"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="pkg-config xorgproto"
RUN_DEPS="xorgproto libSM-devel libX11-devel"

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
