PORT_NAME="libXaw3d"
PORT_VERSION="1.6.6"
PORT_RELEASE="1"
PORT_DESC="X Athena Widget 3d library"
PORT_URL="https://cgit.freedesktop.org/xorg/lib/libXaw3d"
PORT_COMMIT="1.6.6"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="automake bison libtool pkg-config"
RUN_DEPS="libXmu-devel libXpm-devel xorg-util-macros"

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
