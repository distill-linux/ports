PORT_NAME="xmessage"
PORT_VERSION="1.0.7"
PORT_RELEASE="1"
PORT_DESC="Display a message or query in a X window"
PORT_URL="http://xorg.freedesktop.org"
PORT_COMMIT="1.0.7"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="pkg-config"
RUN_DEPS="libXaw-devel"

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
