PORT_NAME="bzip2"
PORT_VERSION="1.0.8"
PORT_RELEASE="1"
PORT_DESC="Freely available, patent free, high-quality data compressor"
PORT_URL="https://sourceware.org/bzip2/"
PORT_ARCH="x86_64"
BUILD_SYSTEM="make"
BUILD_DEPS=""
RUN_DEPS=""

BUILD:
make -f Makefile-libbz2_so
make -j$(nproc)
make PREFIX="$PKG_FAKEROOT/usr" install
