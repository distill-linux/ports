PORT_NAME="libXmu"
PORT_VERSION="1.3.1"
PORT_RELEASE="1"
PORT_DESC="X Miscellaneous Utilities library"
PORT_URL="https://wiki.freedesktop.org/xorg/"
PORT_COMMIT="1.3.1"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="pkg-config"
RUN_DEPS="libXext-devel libXt-devel"

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
