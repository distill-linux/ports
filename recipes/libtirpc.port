PORT_NAME="libtirpc"
PORT_VERSION="1.3.7"
PORT_RELEASE="1"
PORT_DESC="Transport Independent RPC library (SunRPC replacement)"
PORT_URL="http://libtirpc.sourceforge.net/"
PORT_ARCH="x86_64"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="mit-krb5-libs"
RUN_DEPS="mit-krb5-libs"

BUILD:
./configure --prefix=/usr --sysconfdir=/etc
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
