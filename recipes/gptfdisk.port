PORT_NAME="gptfdisk"
PORT_VERSION="1.0.10"
PORT_RELEASE="1"
PORT_DESC="GPT fdisk text-mode partitioning tool"
PORT_URL="https://www.rodsbooks.com/gdisk/"
PORT_COMMIT="1.0.10"
