PORT_NAME="sink"
PORT_VERSION="0.1.0"
PORT_RELEASE="1"
PORT_DESC="Community source builder and ports engine for Distill Linux"
PORT_URL="https://github.com/distill-linux/sink.git"
PORT_COMMIT="main"
BUILD_SYSTEM="samu"
BUILD_DEPS="samurai"
RUN_DEPS="libgit2 curl"

BUILD:
samu
install -D -m 755 sink "$PKG_FAKEROOT/usr/bin/sink"
