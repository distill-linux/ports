PORT_NAME="greetd"
PORT_VERSION="0.10.3"
PORT_RELEASE="1"
PORT_DESC="Minimal and flexible login manager daemon"
PORT_URL="https://git.sr.ht/~kennylevinsen/greetd"
PORT_ARCH="x86_64"
BUILD_SYSTEM="cargo"
BUILD_DEPS="cargo pam-libs"
RUN_DEPS="linux-pam libgcc"

BUILD:
cargo build --release
install -Dm755 target/release/greetd "$PKG_FAKEROOT/usr/bin/greetd"
install -Dm755 target/release/agreety "$PKG_FAKEROOT/usr/bin/agreety"
install -Dm644 config.toml "$PKG_FAKEROOT/etc/greetd/config.toml"
