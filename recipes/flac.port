PORT_NAME="flac"
PORT_VERSION="1.5.0"
PORT_RELEASE="1"
PORT_DESC="Free Lossless Audio Codec"
PORT_URL="https://xiph.org/flac/"
PORT_COMMIT="1.5.0"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="pkg-config"
RUN_DEPS="libogg"

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
