PORT_NAME="libXpm"
PORT_VERSION="3.5.19"
PORT_RELEASE="1"
PORT_DESC="X PixMap Library from modular Xorg X11"
PORT_URL="https://www.x.org/"
PORT_COMMIT="3.5.19"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="gettext pkg-config"
RUN_DEPS="xorgproto libSM-devel libXext-devel libXt-devel"

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
