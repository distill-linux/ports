PORT_NAME="zathura-pdf-mupdf"
PORT_VERSION="2026.07.18"
PORT_RELEASE="1"
PORT_DESC="PDF support for zathura (using mupdf)"
PORT_URL="https://pwmt.org/projects/zathura-pdf-mupdf/"
PORT_COMMIT="2026.07.18"
BUILD_SYSTEM="meson"
BUILD_DEPS="pkg-config"
RUN_DEPS="zathura"

BUILD:
meson setup build --prefix=/usr --buildtype=release
samu -C build
DESTDIR="$PKG_FAKEROOT" samu -C build install
