PORT_NAME="firejail"
PORT_VERSION="0.9.80"
PORT_RELEASE="1"
PORT_DESC="Linux namespaces sandbox program using seccomp-bpf filters"
PORT_URL="https://github.com/netblue30/firejail.git"
PORT_ARCH="x86_64"
RUN_DEPS=""

BUILD:
./configure --prefix=/usr --sysconfdir=/etc
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
