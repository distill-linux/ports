PORT_NAME="libgcc"
PORT_VERSION="14.2.1"
PORT_RELEASE="1"
PORT_DESC="GNU C Compiler runtime shared libraries"
PORT_URL="https://gcc.gnu.org/"
PORT_ARCH="x86_64"
BUILD_SYSTEM="custom"
BUILD_DEPS=""
RUN_DEPS=""

BUILD:
install -d "$PKG_FAKEROOT/usr/lib"
cp -a /usr/lib/libgcc_s.so* "$PKG_FAKEROOT/usr/lib/"
