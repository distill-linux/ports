PORT_NAME="libXinerama"
PORT_VERSION="1.1.6"
PORT_RELEASE="1"
PORT_DESC="X PanoramiX extension library"
PORT_URL="https://www.x.org/"
PORT_COMMIT="1.1.6"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="pkg-config"
RUN_DEPS="xorgproto libXext-devel"

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
