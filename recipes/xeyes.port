PORT_NAME="xeyes"
PORT_VERSION="1.3.1"
PORT_RELEASE="1"
PORT_DESC="Follow the mouse"
PORT_URL="http://www.x.org/archive/X11R6.8.1/doc/xeyes.1.html"
PORT_COMMIT="1.3.1"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="pkg-config xorg-util-macros"
RUN_DEPS="libXmu libXt libXrender libXi"

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
