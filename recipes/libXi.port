PORT_NAME="libXi"
PORT_VERSION="1.8.3"
PORT_RELEASE="1"
PORT_DESC="X Input extension library"
PORT_URL="https://gitlab.freedesktop.org/xorg/lib/libxi"
PORT_COMMIT="1.8.3"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="pkg-config xmlto"
RUN_DEPS="libXfixes libXext"

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
