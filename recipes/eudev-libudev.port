PORT_NAME="eudev-libudev"
PORT_VERSION="3.2.14"
PORT_RELEASE="1"
PORT_DESC="Fork of systemd-udev - shared library"
PORT_URL="https://github.com/eudev-project/eudev"
PORT_ARCH="x86_64"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS=""
RUN_DEPS=""

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
