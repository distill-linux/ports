PORT_NAME="libvdpau"
PORT_VERSION="1.5"
PORT_RELEASE="1"
PORT_DESC="Video Decode and Presentation API for UNIX"
PORT_URL="https://freedesktop.org/wiki/Software/VDPAU/"
PORT_COMMIT="1.5"
BUILD_SYSTEM="meson"
BUILD_DEPS="pkg-config"
RUN_DEPS="libXext"

BUILD:
meson setup build --prefix=/usr --buildtype=release
samu -C build
DESTDIR="$PKG_FAKEROOT" samu -C build install
