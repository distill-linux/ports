PORT_NAME="libogg"
PORT_VERSION="1.3.6"
PORT_RELEASE="1"
PORT_DESC="Ogg bitstream file format library"
PORT_URL="https://www.xiph.org/ogg/"
PORT_COMMIT="1.3.6"
BUILD_SYSTEM="gnu-configure"
