PORT_NAME="libepoxy"
PORT_VERSION="1.5.10"
PORT_RELEASE="1"
PORT_DESC="Library for handling OpenGL function pointer management for you"
PORT_URL="https://github.com/anholt/libepoxy"
PORT_COMMIT="1.5.10"
BUILD_SYSTEM="meson"
BUILD_DEPS="pkg-config xorg-util-macros"
RUN_DEPS=""

BUILD:
meson setup build --prefix=/usr --buildtype=release
samu -C build
DESTDIR="$PKG_FAKEROOT" samu -C build install
