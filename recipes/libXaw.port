PORT_NAME="libXaw"
PORT_VERSION="1.0.16"
PORT_RELEASE="1"
PORT_DESC="X Athena Widgets Library"
PORT_URL="http://xorg.freedesktop.org"
PORT_COMMIT="1.0.16"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="pkg-config"
RUN_DEPS="libXext libXt libXmu libXpm"

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
