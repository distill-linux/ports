PORT_NAME="podman"
PORT_VERSION="5.8.3"
PORT_RELEASE="1"
PORT_DESC="Tool and library for managing OCI containers and pods without a daemon"
PORT_URL="https://github.com/containers/podman.git"
PORT_ARCH="x86_64"
RUN_DEPS="crun conmon cni-plugins libseccomp iptables"

BUILD:
make -j$(nproc) PREFIX=/usr
make install DESTDIR="$PKG_FAKEROOT" PREFIX=/usr
