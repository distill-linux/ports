PORT_NAME="snapd"
PORT_VERSION="2.68.0"
PORT_RELEASE="1"
PORT_DESC="Service and tools for management of snap packages"
PORT_URL="https://github.com/canonical/snapd.git"
PORT_ARCH="x86_64"
RUN_DEPS="util-linux"

BUILD:
./autogen.sh --prefix=/usr --sysconfdir=/etc --localstatedir=/var
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
