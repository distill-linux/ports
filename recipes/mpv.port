PORT_NAME="mpv"
PORT_VERSION="0.41.0"
PORT_RELEASE="1"
PORT_DESC="Video player based on MPlayer/mplayer2"
PORT_URL="https://mpv.io"
PORT_COMMIT="0.41.0"
BUILD_SYSTEM="meson"
BUILD_DEPS="pkg-config python3-docutils $(vopt_if wayland wayland-devel)"
RUN_DEPS="MesaLib-devel ffmpeg6-devel harfbuzz-devel libXv-devel libass-devel
 libbluray-devel libcdio-paranoia-devel libdvdnav-devel libuuid-devel libva-devel
 rubberband-devel uchardet-devel libplacebo-devel libarchive-devel libdisplay-info-devel
 $(vopt_if alsa alsa-lib-devel) $(vopt_if caca libcaca-devel)
 $(vopt_if jack jack-devel) $(vopt_if javascript mujs-devel) $(vopt_if lcms lcms2-devel)
 $(vopt_if lua lua52-devel) $(vopt_if openal libopenal-devel)
 $(vopt_if pulseaudio pulseaudio-devel) $(vopt_if pipewire pipewire-devel)
 $(vopt_if vapoursynth vapoursynth-devel) $(vopt_if vdpau libvdpau-devel)
 $(vopt_if sndio sndio-devel) $(vopt_if vulkan "

BUILD:
meson setup build --prefix=/usr --buildtype=release
samu -C build
DESTDIR="$PKG_FAKEROOT" samu -C build install
