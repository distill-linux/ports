PORT_NAME="libXau"
PORT_VERSION="1.0.12"
PORT_RELEASE="1"
PORT_DESC="Authorization Protocol for X"
PORT_URL="$XORG_SITE"
PORT_COMMIT="1.0.12"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="pkg-config"
RUN_DEPS="xorgproto"

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
