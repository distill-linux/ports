PORT_NAME="fbv"
PORT_VERSION="1.0b"
PORT_RELEASE="1"
PORT_DESC="Framebuffer image viewer"
PORT_URL="http://www.eclis.ch/fbv/"
PORT_COMMIT="1.0b"
BUILD_SYSTEM="configure"
BUILD_DEPS=""
RUN_DEPS="libpng libjpeg-turbo giflib"

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
