PORT_NAME="libXft"
PORT_VERSION="2.3.9"
PORT_RELEASE="1"
PORT_DESC="Library for configuring and customizing font access"
PORT_URL="https://gitlab.freedesktop.org/xorg/lib/libxft"
PORT_COMMIT="2.3.9"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="pkg-config"
RUN_DEPS="libXrender freetype fontconfig"

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
