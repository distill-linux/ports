PORT_NAME="terminus-font"
PORT_VERSION="4.49.1"
PORT_RELEASE="1"
PORT_DESC="Clean, fixed width bitmap font"
PORT_URL="http://terminus-font.sourceforge.net/"
PORT_COMMIT="4.49.1"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="python3 bdftopcf font-util"
RUN_DEPS=""

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
