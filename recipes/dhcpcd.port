PORT_NAME="dhcpcd"
PORT_VERSION="10.3.2"
PORT_RELEASE="1"
PORT_DESC="RFC2131 compliant DHCP client"
PORT_URL="https://roy.marples.name/projects/dhcpcd"
PORT_COMMIT="10.3.2"
BUILD_SYSTEM="configure"
BUILD_DEPS="ntp pkg-config"
RUN_DEPS=""

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
