PORT_NAME="xmodmap"
PORT_VERSION="1.0.12"
PORT_RELEASE="1"
PORT_DESC="X modmap program to modify keymaps and pointer button mappings"
PORT_URL="http://xorg.freedesktop.org"
PORT_COMMIT="1.0.12"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="pkg-config"
RUN_DEPS="libX11"

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
