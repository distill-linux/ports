PORT_NAME="xwud"
PORT_VERSION="1.0.8"
PORT_RELEASE="1"
PORT_DESC="Image displayer for X"
PORT_URL="http://xorg.freedesktop.org"
PORT_COMMIT="1.0.8"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="pkg-config"
RUN_DEPS="libX11"

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
