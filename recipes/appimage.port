PORT_NAME="appimage"
PORT_VERSION="1.0"
PORT_RELEASE="1"
PORT_DESC="AppImage runtime and desktop integration utility"
PORT_URL="https://github.com/AppImage/AppImageKit.git"
PORT_ARCH="x86_64"
RUN_DEPS="zlib"

BUILD:
cmake -B build -S . -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release
samu -C build
DESTDIR="$PKG_FAKEROOT" samu -C build install
