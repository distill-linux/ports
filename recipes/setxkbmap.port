PORT_NAME="setxkbmap"
PORT_VERSION="1.3.4"
PORT_RELEASE="1"
PORT_DESC="Set the keyboard map using the X Keyboard Extension"
PORT_URL="https://gitlab.freedesktop.org/xorg/app/setxkbmap"
PORT_COMMIT="1.3.4"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="pkg-config"
RUN_DEPS="libX11-devel libxkbfile-devel libXrandr-devel"

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
