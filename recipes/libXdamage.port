PORT_NAME="libXdamage"
PORT_VERSION="1.1.7"
PORT_RELEASE="1"
PORT_DESC="Xdamage extension Library"
PORT_URL="https://wiki.freedesktop.org/xorg/"
PORT_COMMIT="1.1.7"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="pkg-config"
RUN_DEPS="libXfixes"

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
