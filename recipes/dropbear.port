PORT_NAME="dropbear"
PORT_VERSION="2025.89"
PORT_RELEASE="1"
PORT_DESC="Small SSH server and client"
PORT_URL="https://matt.ucc.asn.au/dropbear/dropbear.html"
PORT_COMMIT="2025.89"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS=""
RUN_DEPS="zlib"

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
