PORT_NAME="util-linux"
PORT_VERSION="2.42.3"
PORT_RELEASE="1"
PORT_DESC="Miscellaneous linux utilities (includes mcookie)"
PORT_URL="https://github.com/util-linux/util-linux"
PORT_COMMIT="v2.42.3"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="gettext pkg-config"
RUN_DEPS="zlib"

BUILD:
./autogen.sh
./configure --prefix=/usr --enable-mcookie --disable-makeinstall-chown --disable-makeinstall-setuid CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
