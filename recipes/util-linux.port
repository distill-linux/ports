PORT_NAME="util-linux"
PORT_VERSION="2.41.4"
PORT_RELEASE="1"
PORT_DESC="Miscellaneous linux utilities"
PORT_URL="https://www.kernel.org/pub/linux/utils/util-linux/"
PORT_COMMIT="2.41.4"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="gettext pkg-config"
RUN_DEPS="zlib"

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
