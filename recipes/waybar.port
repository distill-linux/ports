PORT_NAME="waybar"
PORT_VERSION="0.15.0"
PORT_RELEASE="1"
PORT_DESC="Polybar-like Wayland Bar for Sway and Wlroots based compositors"
PORT_URL="https://github.com/Alexays/Waybar"
PORT_COMMIT="0.15.0"
BUILD_SYSTEM="meson"
BUILD_DEPS="cmake pkg-config glib-devel wayland-devel scdoc
 $(vopt_if dbusmenugtk gobject-introspection)"
RUN_DEPS="wayland"

BUILD:
meson setup build --prefix=/usr --buildtype=release
samu -C build
DESTDIR="$PKG_FAKEROOT" samu -C build install
