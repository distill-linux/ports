PORT_NAME="zstd"
PORT_VERSION="1.5.7"
PORT_RELEASE="1"
PORT_DESC="Fast real-time compression algorithm - CLI tool"
PORT_URL="https://facebook.github.io/zstd/"
PORT_COMMIT="1.5.7"
BUILD_SYSTEM="make"
BUILD_DEPS=""
