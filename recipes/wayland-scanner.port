PORT_NAME="wayland-scanner"
PORT_VERSION="1.23.0"
PORT_RELEASE="1"
PORT_DESC="Wayland XML protocol tool for generating C bindings"
PORT_URL="https://gitlab.freedesktop.org/wayland/wayland.git"
PORT_COMMIT="1.23.0"
BUILD_SYSTEM="meson"
BUILD_DEPS=""
RUN_DEPS=""

BUILD:
meson setup build --prefix=/usr -Ddocumentation=false
samu -C build wayland-scanner
install -D -m 755 build/wayland-scanner "$PKG_FAKEROOT/usr/bin/wayland-scanner"
