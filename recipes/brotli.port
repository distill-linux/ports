PORT_NAME="brotli"
PORT_VERSION="1.1.0"
PORT_RELEASE="1"
PORT_DESC="Generic-purpose lossless compression algorithm"
PORT_URL="https://github.com/google/brotli"
PORT_ARCH="x86_64"
BUILD_SYSTEM="cmake"
BUILD_DEPS=""
RUN_DEPS=""

BUILD:
cmake -B build -DCMAKE_INSTALL_PREFIX=/usr
samu -C build
DESTDIR="$PKG_FAKEROOT" samu -C build install
