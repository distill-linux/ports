PORT_NAME="xprop"
PORT_VERSION="1.2.8"
PORT_RELEASE="1"
PORT_DESC="Property displayer for X"
PORT_URL="https://gitlab.freedesktop.org/xorg/app/xprop"
PORT_COMMIT="1.2.8"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="pkg-config"
RUN_DEPS="libX11-devel libXmu-devel"

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
