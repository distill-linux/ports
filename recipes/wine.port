PORT_NAME="wine"
PORT_VERSION="11.16"
PORT_RELEASE="1"
PORT_DESC="Compatibility layer for running Windows applications on POSIX systems"
PORT_URL="https://gitlab.winehq.org/wine/wine.git"
PORT_ARCH="x86_64"
RUN_DEPS="freetype fontconfig libX11 libXext libXrender mesa alsa-lib"

BUILD:
./configure --prefix=/usr --enable-win64
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
