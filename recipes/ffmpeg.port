PORT_NAME="ffmpeg"
PORT_VERSION="4.4.8"
PORT_RELEASE="1"
PORT_DESC="Decoding, encoding and streaming software (transitional dummy package)"
PORT_URL="https://www.ffmpeg.org"
PORT_COMMIT="4.4.8"
BUILD_SYSTEM="make"
BUILD_DEPS="pkg-config perl"
RUN_DEPS="zlib freetype alsa-lib libXfixes libXext libxcb libvorbis harfbuzz"

BUILD:
make CC=clang PREFIX=/usr
make DESTDIR="$PKG_FAKEROOT" PREFIX=/usr install
