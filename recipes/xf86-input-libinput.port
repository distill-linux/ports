PORT_NAME="xf86-input-libinput"
PORT_VERSION="1.5.0"
PORT_RELEASE="1"
PORT_DESC="Generic input driver for the X.Org server based on libinput"
PORT_URL="https://xorg.freedesktop.org/"
PORT_COMMIT="1.5.0"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="pkg-config"
RUN_DEPS=""

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
