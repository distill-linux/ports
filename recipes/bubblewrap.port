PORT_NAME="bubblewrap"
PORT_VERSION="0.12.0"
PORT_RELEASE="1"
PORT_DESC="Unprivileged sandboxing tool utilizing Linux user namespaces"
PORT_URL="https://github.com/containers/bubblewrap.git"
PORT_ARCH="x86_64"
RUN_DEPS="libcap libseccomp"

BUILD:
meson setup build --prefix=/usr --buildtype=release
samu -C build
DESTDIR="$PKG_FAKEROOT" samu -C build install
