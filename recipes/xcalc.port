PORT_NAME="xcalc"
PORT_VERSION="1.1.3"
PORT_RELEASE="1"
PORT_DESC="Scientific calculator for X"
PORT_URL="http://www.x.org/archive/X11R6.8.1/doc/xcalc.1.html"
PORT_COMMIT="1.1.3"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="pkg-config xorg-util-macros"
RUN_DEPS="libXaw"

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
