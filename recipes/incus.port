PORT_NAME="incus"
PORT_VERSION="6.22.0"
PORT_RELEASE="1"
PORT_DESC="Community fork of LXD system container and virtual machine manager"
PORT_URL="https://github.com/lxc/incus.git"
PORT_ARCH="x86_64"
RUN_DEPS="lxc ebtables dnsmasq rsync squashfs-tools"

BUILD:
make -j$(nproc)
mkdir -p "$PKG_FAKEROOT/usr/bin"
cp bin/incus bin/incusd "$PKG_FAKEROOT/usr/bin/" 
