PORT_NAME="bc"
PORT_VERSION="7.0.3"
PORT_RELEASE="1"
PORT_DESC="Arbitrary-precision decimal arithmetic language and calculator"
PORT_URL="https://github.com/gavinhoward/bc"
BUILD_SYSTEM="custom"
BUILD_DEPS=""
RUN_DEPS=""

BUILD:
./configure.sh --opt=3 --prefix=/usr
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
