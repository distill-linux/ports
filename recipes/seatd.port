PORT_NAME="seatd"
PORT_VERSION="0.9.3"
PORT_RELEASE="1"
PORT_DESC="Minimal seat management daemon"
PORT_URL="https://sr.ht/~kennylevinsen/seatd/"
PORT_COMMIT="0.9.3"
BUILD_SYSTEM="meson"
BUILD_DEPS="pkg-config scdoc"
RUN_DEPS=""

BUILD:
meson setup build --prefix=/usr --buildtype=release
samu -C build
DESTDIR="$PKG_FAKEROOT" samu -C build install
