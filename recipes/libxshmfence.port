PORT_NAME="libxshmfence"
PORT_VERSION="1.3.3"
PORT_RELEASE="1"
PORT_DESC="X Shared memory 'SyncFence' synchronization primitive"
PORT_URL="http://xorg.freedesktop.org/"
PORT_COMMIT="1.3.3"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="pkg-config"
RUN_DEPS="xorgproto"

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
