PORT_NAME="openssl"
PORT_VERSION="3.3.0"
PORT_RELEASE="1"
PORT_DESC="Toolkit for Transport Layer Security and Secure Sockets Layer protocols"
PORT_URL="https://www.openssl.org"
BUILD_SYSTEM="custom"
BUILD_DEPS="zlib"
RUN_DEPS="zlib"

BUILD:
./Configure linux-x86_64 --prefix=/usr --openssldir=/etc/ssl --libdir=lib no-shared
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install_sw
