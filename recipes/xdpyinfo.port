PORT_NAME="xdpyinfo"
PORT_VERSION="1.4.0"
PORT_RELEASE="1"
PORT_DESC="Display information utility for X"
PORT_URL="https://gitlab.freedesktop.org/xorg/app/xdpyinfo"
PORT_COMMIT="1.4.0"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="pkg-config"
RUN_DEPS="libXext libXtst libXrender libXcomposite libXinerama"

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
