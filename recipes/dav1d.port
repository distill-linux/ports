PORT_NAME="dav1d"
PORT_VERSION="1.5.3"
PORT_RELEASE="1"
PORT_DESC="Small and fast AV1 Decoder"
PORT_URL="https://code.videolan.org/videolan/dav1d"
PORT_COMMIT="1.5.3"
BUILD_SYSTEM="meson"
BUILD_DEPS=""
RUN_DEPS=""

BUILD:
meson setup build --prefix=/usr --buildtype=release
samu -C build
DESTDIR="$PKG_FAKEROOT" samu -C build install
