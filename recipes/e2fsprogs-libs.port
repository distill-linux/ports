PORT_NAME="e2fsprogs-libs"
PORT_VERSION="1.47.2"
PORT_RELEASE="1"
PORT_DESC="Ext2/3/4 Filesystem Utilities - shared libraries"
PORT_URL="http://e2fsprogs.sourceforge.net/"
PORT_ARCH="x86_64"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS=""
RUN_DEPS=""

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
