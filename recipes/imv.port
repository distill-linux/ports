PORT_NAME="imv"
PORT_VERSION="5.0.1"
PORT_RELEASE="1"
PORT_DESC="Image viewer for X11/Wayland"
PORT_URL="https://sr.ht/~exec64/imv/"
PORT_COMMIT="5.0.1"
BUILD_SYSTEM="meson"
BUILD_DEPS="asciidoc pkg-config cmake wayland-devel"
RUN_DEPS="pango libxkbcommon wayland libwebp"

BUILD:
meson setup build --prefix=/usr --buildtype=release
samu -C build
DESTDIR="$PKG_FAKEROOT" samu -C build install
