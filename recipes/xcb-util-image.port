PORT_NAME="xcb-util-image"
PORT_VERSION="0.4.1"
PORT_RELEASE="1"
PORT_DESC="Utility libraries for XCB - XImage and XShmImage functions"
PORT_URL="https://gitlab.freedesktop.org/xorg/lib/libxcb-image"
PORT_COMMIT="0.4.1"
BUILD_SYSTEM="gnu-configure"
BUILD_DEPS="pkg-config"
RUN_DEPS="xcb-util-devel"

BUILD:
./configure --prefix=/usr CC=clang
make -j$(nproc)
make DESTDIR="$PKG_FAKEROOT" install
