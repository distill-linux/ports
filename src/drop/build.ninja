cc = clang
cflags = -Os -fno-asynchronous-unwind-tables -ffunction-sections -fdata-sections -Wall -Wextra -pedantic -Werror -std=c99 -I../common
ldflags = -Wl,--gc-sections
libs = -lz

rule cc
  command = $cc $cflags -c $in -o $out
  description = CC $out

rule link
  command = $cc $ldflags $in $libs -o $out && strip -s $out
  description = LINK $out

build main.o: cc main.c
build index.o: cc index.c
build db.o: cc db.c
build extractor.o: cc extractor.c
build ../common/port.o: cc ../common/port.c
build ../common/sha256.o: cc ../common/sha256.c
build ../common/spawn_util.o: cc ../common/spawn_util.c
build ../common/tar.o: cc ../common/tar.c

build drop: link main.o index.o db.o extractor.o ../common/port.o ../common/sha256.o ../common/spawn_util.o ../common/tar.o

default drop
